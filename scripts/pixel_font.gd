static var _font: FontFile = null


static func get_font() -> FontFile:
	if _font != null:
		return _font
	var count := GLYPHS.size() / 5
	var cell := 6
	var img := Image.create(count * cell, 8, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	for g in count:
		for cx in 5:
			var bits: int = GLYPHS[g * 5 + cx]
			for cy in 7:
				if bits & (1 << cy):
					img.set_pixel(g * cell + cx, cy, Color.WHITE)
	var f := FontFile.new()
	f.fixed_size = 8
	f.fixed_size_scale_mode = TextServer.FIXED_SIZE_SCALE_INTEGER_ONLY
	f.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	f.generate_mipmaps = false
	var sz := Vector2i(8, 0)
	f.set_cache_ascent(0, 8, 7.0)
	f.set_cache_descent(0, 8, 2.0)
	f.set_texture_image(0, sz, 0, img)
	for g in count:
		var code := 32 + g
		f.set_glyph_advance(0, 8, code, Vector2(6, 0))
		f.set_glyph_offset(0, sz, code, Vector2(0, -7))
		f.set_glyph_size(0, sz, code, Vector2(cell, 8))
		f.set_glyph_uv_rect(0, sz, code, Rect2(g * cell, 0, cell, 8))
		f.set_glyph_texture_idx(0, sz, code, 0)
	_font = f
	return f
